
/-- **The differences** from `0x@A@`: `_zero_` two more references, in the
slots of `d1` (`0x40(sp)`) and `d2` (`0x48(sp)`); `d1 = u1 - u0` by `bc_sub`. -/
theorem ksubs_@A@ {live : Nat → Prop} {S : Nat → Prop}
    {Q : (Nat → BitVec 64) → (Nat → BitVec 8) → Prop} (hlive : ∀ p ∈ dcText, live p.1)
    {M0 M : Mem} {R0 R : Nat → BitVec 64} {sp q W n la lb : Nat} {A B : List NumObj}
    {z : NumObj} {u v : NumRep} {H : Heap} {F : List Blk} {hu1 hu0 hv1 hv0 : Hd} {hs : List Hd}
    (cx : RmCtx S R0 sp q W) (hk : RmK live S Q R0 M0 (A ++ z :: B) u v la lb q sp W)
    (hW : 368 ≤ W) (pk : KM1 S M0 M R0 R sp q W n la lb z hu1 hu0 hv1 hv0)
    (h17 : R 17 = BitVec.ofNat 64 z.rep.p)
    (hb : BcHeap S M H F (KList [] hs A B z))
    (hu1m : hu1 ∈ hs) (hu0m : hu0 ∈ hs) (hv0m : hv0 ∈ hs) (hv1m : hv1 ∈ hs)
    (sa1 : KSubArgs z hu1 hu0) (sa2 : KSubArgs z hv0 hv1)
    (hzr : 1 ≤ z.rep.refs) (hzk : z.rep.refs + zeroCount hs + 2 < 2 ^ 31)@H26P@
    (hnext : KSubsK live S Q M0 M R0 sp q W n la lb z hu1 hu0 hv1 hv0 hs A B 0x@E@#64) :
    DW live S Q 0x@A@#64 R M := by
  have hS : HeapOwn S := fun a h1 h2 => hb.heap.own a h1 h2
  have hzm : z.withRefs (z.rep.refs + zeroCount hs) ∈ KList [] hs A B z :=
    List.mem_append_right _ List.mem_cons_self
  have hn := hb.nums _ hzm
  have hrf : ldv .lw M (z.rep.p + 12) = BitVec.ofNat 64 (z.rep.refs + zeroCount hs) := hn.refs
  have e1 : 2147603920 ≤ z.rep.p := hn.shape.pLo
  have e2 : z.rep.p + 40 ≤ heapEnd := hn.shape.pHi
  have e3 : z.rep.p % 8 = 0 := hn.shape.pAl
  simp only [heapEnd] at e2
  have h2 := pk.st.rm.r2
  have h19 := pk.u0; have h24 := pk.u1
  have hsf := cx.frame
  have hsl := hsf.lo; have hsh := hsf.hi; have hsa := hsf.al
  have hab := cx.above; have hW' := cx.big
  simp only [heapEnd] at hab
  have htx : tohostAddr = 0x8001ad00 := rfl
  bc_run hlive hS [h17, hrf, h2, h19, h24, sxw_ofNat] at 0x@J1@
  all_goals first | exact frame_acc hsf (by omega) (by omega) | skip
  apply st_@J1@ hlive
  have hmo : MemOnly (fun a => z.rep.p + 12 ≤ a ∧ a < z.rep.p + 12 + 4)
      (writeLog M [(z.rep.p + 12, 4, BitVec.ofNat 64 (z.rep.refs + zeroCount hs + 2))]) M :=
    MemOnly.store _ _ _ _
  have hP1 : ∀ a, (z.rep.p + 12 ≤ a ∧ a < z.rep.p + 12 + 4) → heapStart ≤ a ∧ a < heapEnd :=
    fun a h => by simp only [heapStart, heapEnd]; omega
  have st1 := (((pk.st.heapOnly cx hmo hP1).storeSlot cx 64 (BitVec.ofNat 64 z.rep.p)
    (by omega)).storeSlot cx 72 (BitVec.ofNat 64 z.rep.p) (by omega))
  have hb1 := (((hb.kzero2 (toNat_ofNat_mod32 (by omega)) hzk).out_frame
    (MemOnly.store _ (sp - 192 + 64) 8 (BitVec.ofNat 64 z.rep.p))
    fun a ha => by simp only [OutHeap, heapStart, heapEnd, freeListAddr, bcFreeAddr]; omega).out_frame
    (MemOnly.store _ (sp - 192 + 72) 8 (BitVec.ofNat 64 z.rep.p))
    fun a ha => by simp only [OutHeap, heapStart, heapEnd, freeListAddr, bcFreeAddr]; omega)
  have hga1 := ((GlobAgree.store (BitVec.ofNat 64 z.rep.p) (w := 8) (a := sp - 192 + 72)
    (M := writeLog (writeLog M [(z.rep.p + 12, 4, BitVec.ofNat 64 (z.rep.refs + zeroCount hs + 2))])
      [(sp - 192 + 64, 8, BitVec.ofNat 64 z.rep.p)]) (by omega)).trans
    (GlobAgree.store _ (by omega))).trans (GlobAgree.store _ (by omega))
  refine kara_subCall hlive cx hk (st1.rm.keeps (by keeps_tac Keeps.refl _ _) (by bsimp [h2])) 64
    (by omega) (by decide) hW
    (sa1.binArgs (P := []) (A := A) (B := B) (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hu1m))
      (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hu0m)))
    (sa1.noAdd _)
    hb1 (KList.resSlot hzr (by rw [ldv_ld_miss _ _ (by omega)]; exact ldv_store_hit _ _ _))
    (by bsimp []) (by bsimp [Hd.objIn_p]) (by bsimp [Hd.objIn_p]) (by bsimp [h2]) (by bsimp []) ?_
  intro R' M' H' F' L' y1 kk post
  bsimp []
  have hrest := post.rest
  cases hrest with
  | rel h => simp only [NumObj.withRefs, zeroCount_none] at h; omega
  | dec _ =>
  have hb2 := post.heap
  rw [KList_subDec y1 (none :: hs) A B z, KList_swapNone] at hb2
  have st2 := st1.subCall cx 64 (by omega) hW post.out
  have h72 : ldv .ld M' (sp - 192 + 72) = BitVec.ofNat 64 z.rep.p := by
    rw [ldv_congr .ld fun j hj => post.out _
      (by simp only [widthOfM] at hj; simp only [OutHeap, heapStart, heapEnd, freeListAddr,
        bcFreeAddr]; omega)
      (by simp only [widthOfM, slotBytes] at hj ⊢; omega)
      (by simp only [widthOfM, frameIn] at hj ⊢; omega)]
    exact ldv_store_hit _ _ _
  have hga2 : GlobAgree M' M :=
    (GlobAgree.call (W' := 176) (sp' := sp - 192) (qs := sp - 192 + 64) (by omega) (by omega)
      post.out).trans hga1
  have kk' : Keeps (1 :: binClob) R' R :=
    (kk.mono (fun r hr => List.mem_cons_of_mem _ hr)).trans (by keeps_tac Keeps.refl _ _)
  exact ksubsB_@B@ hlive cx hk hW ((pk.mem st2).keeps kk') hb2 post.slot h72 hv0m hv1m sa2 hzr
    ⟨by rw [post.num, Hd.objIn_num, Hd.objIn_num], post.norm, post.refs, post.owns,
      post.pos⟩ hga2@H26A@ hnext
