import Dc.Mach.EvalExit

/-!
# `evalstr`'s status dispatch (M10)

After `dc_func` returns, `evalstr` jumps through one of two word tables on
the status (`s2 = 0x80008134` after a character with a lookahead, `s3 =
0x80008160` after the last one). `ev_disp_tac` runs one status's dispatch
(the bound test `bltu s4, a0`, the table word decided once, the `jr`);
`evm_<code>`/`evl_<code>` are its instances (generated by
`scripts/dc/gen_ev_disp.py`; do not edit).
-/

namespace Dc.Mach

open Vsa.MemRepr Vsa.Sim VsaIris VsaIris.Inst VsaIris.Sym VsaIris.MallocFast VsaIris.Interp
open LeanRV64DExecutable LeanRV64DExecutable.Functions Sail

set_option linter.unusedSimpArgs false

local macro_rules | `(tactic| sx_side) => `(tactic| dc_side)

set_option hygiene false in
/-- One status's dispatch: the table word at `addr` is `val`, the target `tgt`. -/
macro "ev_disp_tac " stop:num addr:num val:num tgt:num : tactic =>
  `(tactic| (
    have htx : tohostAddr = 0x8001ad00 := rfl
    bc_run hlive hlive [h10, cs.s2, cs.s3, cs.s4] at $stop
    bc_run hlive hlive [h10, cs.s2, cs.s3, cs.s4] at $stop
    dx_ro hlive
    · gnorm; decide
    · gnorm; decide +kernel
    gnorm
    simp only [BitVec.reduceShiftLeftShiftLeft, BitVec.reduceHShiftLeft, BitVec.reduceAdd,
      BitVec.reduceToNat]
    rw [show ldvf .lw dcROImg $addr = BitVec.ofNat 64 $val by decide +kernel]
    bc_run hlive hlive [cs.s2, cs.s3] at $tgt
    exact hk _ (by keeps_tac Keeps.refl _ _)))

/-- Status `0` after a character with a lookahead: to `0x800017ec`. -/
theorem evm_0 {live S : Nat → Prop} {Q : String → (Nat → BitVec 64) → (Nat → BitVec 8) → Prop}
    (hlive : ∀ p ∈ dcText, live p.1) {t : String} {R : Nat → BitVec 64} {M : Mem}
    (h10 : R 10 = BitVec.ofNat 64 0) (cs : EvConsts R)
    (hk : ∀ R', Keeps [10, 15] R' R → DWO live S Q t 0x800017ec#64 R' M) :
    DWO live S Q t 0x80001528#64 R M := by
  ev_disp_tac 0x80001534 2147516724 18446744073709524664 0x800017ec

