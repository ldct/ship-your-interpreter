    DWO live S Q (t0 ++ Dc.outStr st.out) 0x80000b9c#64 R M :=
  fn_arm hp hr (dcf_disp_60 hlive hp.heapOwn (hp.frame.mono (by have := hp.stk; have := hp.stkPr; have := hp.stkDn; omega))
